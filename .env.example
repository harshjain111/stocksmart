# Public URL of this app - used to build invite/reset email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only, never expose to the browser.
# Used for admin-only operations (e.g. inviting users) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
